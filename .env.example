# Demand Radar configuration. Copy to .env and fill in what you need.
# Everything here is optional: collection and the cheap relevance filter run
# with no credentials. The keys below unlock structured LLM screening.

# --- TypeSafe Jev: stage 2, carries the bulk of classification ---
# Key from https://console.typesafe.ai/keys
TYPESAFE_JEV_API_KEY=
# JEV_MODEL=jev-latest

# --- Reddit (optional; needed for subreddit research) ---
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# --- Gemini: stage 3, only for text fields Jev cannot produce ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
